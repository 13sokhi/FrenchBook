<Window x:Class="FrenchBookApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrenchBookApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Settings" Height="210" Width="300">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Voice Speed" FontSize="22" Margin="0 0 0 10"/>

            <RadioButton Content="Normal" Margin="5,0,5,5" GroupName="Speed" x:Name="NormalRB" IsChecked="True"/>
            <RadioButton Content="Slow" Margin="5,0,5,5" GroupName="Speed" x:Name="SlowRB"/>
            <RadioButton Content="Slower" Margin="5,0,5,5" GroupName="Speed" x:Name="SlowerRB" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                <Button x:Name="okBtn" Content="OK" Width="80" Margin="0 0 10 0" Click="okBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
